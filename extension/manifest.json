{
  "manifest_version": 3,
  "name": "Muminmuggar – Mukify import",
  "version": "1.0.0",
  "description": "Import your Mukify collection into Muminmuggar with one click.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://database-prod.mukify.com/*",
    "https://muminmuggar.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Muminmuggar import" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.mukify.com/*", "https://mukify.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
